# Copy to .env (which is gitignored) and fill in. Never commit real values.
# Keep this file in sync: every variable read in src/spendcube/config.py belongs here.
# Rule of thumb: secrets and machine-specific values go in .env; everything else in code.

# Where data and outputs live. Code is in the repo (C:\Users\<you>\dev\projects\spendcube); data is
# never in the repo and can live anywhere: the OneDrive project folder (raw, interim, processed,
# sample), a folder of a synced SharePoint library (below), SQL Server, an API. Delete what this
# project doesn't use.
# DATA_DIR=C:\Users\<you>\OneDrive - Boston University\Data Projects\spendcube
DATA_DIR=data
OUTPUTS_DIR=outputs

# Synced SharePoint libraries. Defaults (in config.py) are under
# C:\Users\<you>\Boston University\Continuous Improvement & Data Analytics - Documents\ ;
# set these only if they are elsewhere on this machine (e.g. the automation computer).
# CIDA_AUTOMATION_DIR=C:\Users\<you>\Boston University\Continuous Improvement & Data Analytics - Documents\Automation and Data
# CIDA_PROJECTS_DIR=C:\Users\<you>\Boston University\Continuous Improvement & Data Analytics - Documents\CIDA Projects

# SQL Server: one server and one login (SQL Server authentication), shared by cida_toolkit
# monitoring and this project. Each database has its own <PURPOSE>_SQL_DATABASE variable.
CIDA_SQL_SERVER=Cida-sql-t-01.bu.edu
CIDA_SQL_USERNAME=
CIDA_SQL_PASSWORD=
# Monitoring database (read by cida_toolkit)
CIDA_MONITORING_SQL_DATABASE=cida_montioring
# This project's database
SPENDCUBE_SQL_DATABASE=

# Asana: one token for everything (cida_toolkit monitoring and any project use)
CIDA_ASANA_ACCESS_TOKEN=

# AWS: prefer a named profile or role over long-lived access keys
# AWS_PROFILE=
# AWS_REGION=
